{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning" } },
    "WriteTo": [{ "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Application} {WorkerId} {Message:lj}{NewLine}{Exception}" } }],
    "Enrich": ["FromLogContext"]
  }
}
